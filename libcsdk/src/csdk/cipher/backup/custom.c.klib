    int ks;		// key size in bits
    int bs;		// cipher block size

    // priv data here, initialised on set key operations, and utilised within the _csdk_encrypt operation.
    KL_CONTEXT encctx = {
		{op_mode, NULL, 0, FALSE, FALSE},
		{ KLA_BLOCK_IV, iv, 0, FALSE, FALSE},
	};
};
