void T_Block_Enc_Dec_SinglePart(int op_mode, int keylen)
{
        KLO_CTX_ARIA_CFB,
        KLO_CTX_ARIA_CTR,
        KLO_CTX_ARIA_GCM,

	//keygeneration
	KL_BYTE SecretKeyBuf[32] = {0x00, }; //Maximum Key Len : 32. Note : This buf size can be 16, 24 or 32 according to the block cipher. 
	KL_OBJECT oKey = {
		{KLO_SECRET_KEY, NULL, 0, FALSE, FALSE},
		{KLA_VALUE, SecretKeyBuf, 0, TRUE, FALSE},
	};

	//For Encryption/Decryption
	KL_BYTE iv[16] = {0xba,0x8c,0x2b,0x53,0xf2,0x9b,0x7f,0xd6,0xd3,0x37,0x7f,0xba,0x29,0x12,0x21,0x7d}; //Maximum IV Len : 16. Note : This buf size can be 16 or 8 according to the block cipher. 
	KL_CONTEXT encctx = {
		{op_mode, NULL, 0, FALSE, FALSE},
		{ KLA_BLOCK_IV, iv, 0, FALSE, FALSE},
	};

	//For Data(Plaintext or Ciphertext)
	KL_BYTE DataBuf[16] = { 0x00, };
	KL_OBJECT oData = {
		{KLO_DATA,	NULL,	 0, FALSE, FALSE},
		{KLA_VALUE, DataBuf, sizeof(DataBuf), FALSE, FALSE}
	};

	//For Encryption Output
	KL_BYTE_PTR EncDataBuf = NULL;
	KL_OBJECT oEncryptedData = {
		{KLO_DATA,	NULL, 0, FALSE, FALSE},
		{KLA_VALUE, EncDataBuf, 0, FALSE, FALSE}
	};

	//For Decryption Output
	KL_BYTE_PTR DecDataBuf = NULL;
	KL_OBJECT oDecryptedData = {
		{KLO_DATA,	NULL, 0, FALSE, FALSE},
		{KLA_VALUE, DecDataBuf, 0, FALSE, FALSE}
	};

	KL_RV ret;

	//Step1 - ÆÄ¶ó¹ÌÅÍ ¼³Á¤
	switch(op_mode)
	{
			/*ARIA*/
		case KLO_CTX_ARIA_CBC:
		case KLO_CTX_ARIA_CBC_PAD:
		case KLO_CTX_ARIA_OFB:
		case KLO_CTX_ARIA_CFB:
		case KLO_CTX_ARIA_CTR:
		case KLO_CTX_ARIA_CTR_PAD:
			encctx[1].type = KLA_BLOCK_IV;
			encctx[1].ulValueLen = KL_ARIA_BLOCK_BYTE_LEN;	//IV  Len : must be the same as the block size
		case KLO_CTX_ARIA_ECB:								//Note : ECB does note require IV
		case KLO_CTX_ARIA_ECB_PAD:
			oKey[1].ulValueLen = keylen;					//Key Len : This chooses one of versions(ARIA128, ARIA192, ARIA256)

			break;

			/*SEED*/
		case KLO_CTX_SEED_CBC:
		case KLO_CTX_SEED_CBC_PAD:
		case KLO_CTX_SEED_OFB:
		case KLO_CTX_SEED_CFB:
		case KLO_CTX_SEED_CTR:
		case KLO_CTX_SEED_CTR_PAD:
			encctx[1].type = KLA_BLOCK_IV;
			encctx[1].ulValueLen = KL_SEED_BLOCK_BYTE_LEN;	//IV  Len : must be the same as the block size
	}
	if (encctx[1].ulValueLen != 0)
		K_HexDump(encctx[1].pValue, encctx[1].ulValueLen, "iv");
	K_HexDump(oData[1].pValue, oData[1].ulValueLen, "input data");

	//Step 2 - Å°»ý¼º : K_GenerateKey
	//// oKey¿¡ Å°¸¦ Á÷Á¢ ³Ö¾îÁÖ¾îµµµÈ´Ù. 
	if ((ret = K_GenerateKey(&keygenctx, (KL_OBJECT_PTR)&oKey)) != KLR_OK)
	{
		printf("K_GenerateKey failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	K_HexDump(oKey[1].pValue, oKey[1].ulValueLen, "Key");

	
	//////////////////////////////////////////
	//¾ÏÈ£È­ ¼öÇà : K_EncryptInit - K_Encrypt
	//////////////////////////////////////////

	//Step 3 - ÄÁÅØ½ºÆ® ÃÊ±âÈ­ : K_EncryptInit
	if( (ret = K_EncryptInit(&encctx,(KL_OBJECT_PTR)&oKey)) != KLR_OK )
	{
		printf("K_EncryptInit failed: %s\n",K_GetErrorMsg(ret));
		goto err;
	}

	//Step 4 - Ãâ·Â Å©±â¸¦ ±¸ÇÑ´Ù. : K_Encrypt
	////(Optional) Ãâ·Â Å©±â¸¦ ¹ÝÈ¯, ÇØ´ç StepÀº »ç¿ëÀÚ°¡ Ãâ·Â BufferÀÇ Å©±â¸¦ ¾Ë°íÀÚ ÇÒ¶§ ¼öÇàÇÑ´Ù.
	oEncryptedData[1].pValue = NULL;
	if ((ret = K_Encrypt(&encctx, (KL_OBJECT_PTR)&oData,
		(KL_OBJECT_PTR)&oEncryptedData)) != KLR_OK)
	{
		printf("K_Encrypt(Obtaining Output Length) failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	oEncryptedData[1].pValue = (KL_BYTE_PTR)malloc(oEncryptedData[1].ulValueLen);
	
	//Step 5 - ¾ÏÈ£È­ : K_Encrypt
	if( (ret = K_Encrypt(&encctx, (KL_OBJECT_PTR)&oData,
		(KL_OBJECT_PTR)&oEncryptedData)) != KLR_OK )
	{
		printf("K_Encrypt failed: %s\n",K_GetErrorMsg(ret));
		goto err;
	}
	K_HexDump(oEncryptedData[1].pValue, oEncryptedData[1].ulValueLen, "encrypted data");


	//////////////////////////////////////////
	//º¹È£È­ ¼öÇà : K_DecryptInit - K_Decrypt
	//////////////////////////////////////////
	
	//Step 3 - ÄÁÅØ½ºÆ® ÃÊ±âÈ­ : K_DecryptInit
	if( (ret = K_DecryptInit(&encctx,
		(KL_OBJECT_PTR)&oKey)) != KLR_OK )
	{
		printf("K_DecryptInit failed: %s\n",K_GetErrorMsg(ret));
		goto err;
	}
	
	//Step 4 - Ãâ·Â Å©±â¸¦ ±¸ÇÑ´Ù. : K_Decrypt
	////(Optional) Ãâ·Â Å©±â¸¦ ¹ÝÈ¯, ÇØ´ç StepÀº »ç¿ëÀÚ°¡ Ãâ·Â BufferÀÇ Å©±â¸¦ ¾Ë°íÀÚ ÇÒ¶§ ¼öÇàÇÑ´Ù.
	oDecryptedData[1].pValue = NULL;
	if ((ret = K_Decrypt(&encctx,
		(KL_OBJECT_PTR)&oEncryptedData,
		(KL_OBJECT_PTR)&oDecryptedData)) != KLR_OK)
	{
		printf("K_Decrypt(Obtaining Output Length) failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	oDecryptedData[1].pValue = (KL_BYTE_PTR)malloc(oDecryptedData[1].ulValueLen);

	//Step 5 - º¹È£È­ : K_Decrypt
	if( (ret = K_Decrypt(&encctx,
		(KL_OBJECT_PTR)&oEncryptedData,
		(KL_OBJECT_PTR)&oDecryptedData)) != KLR_OK )
	{
		printf("K_Decrypt failed: %s\n",K_GetErrorMsg(ret));
		goto err;
	}
	K_HexDump(oDecryptedData[1].pValue, oDecryptedData[1].ulValueLen, "decrypted data");


err:
	//»ç¿ë ÄÁÅØ½ºÆ®, ¿ÀºêÁ§Æ® ÃÊ±âÈ­
	K_ClearSensitive((KL_OBJECT_PTR)&encctx, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oKey, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oData, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oEncryptedData, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oDecryptedData, 2);

	if (oEncryptedData[1].pValue != NULL)
		free(oEncryptedData[1].pValue);
	if (oDecryptedData[1].pValue != NULL)
		free(oDecryptedData[1].pValue);

}

void T_Block_Enc_Dec_MultiPart(int op_mode, int keylen)
{
	};

	//For Encryption/Decryption
	KL_BYTE iv[16] = { 0xba,0x8c,0x2b,0x53,0xf2,0x9b,0x7f,0xd6,0xd3,0x37,0x7f,0xba,0x29,0x12,0x21,0x7d }; //Maximum IV Len : 16. Note : This buf size can be 16 or 8 according to the block cipher. 
	KL_CONTEXT encctx = {
		{ op_mode, NULL, 0, FALSE, FALSE },
		{ KLA_BLOCK_IV, iv, 0, FALSE, FALSE },
	};

	//For 2 Plaintexts(as an example)
	KL_BYTE DataBuf1[16] = { 0x00, };
	KL_OBJECT oData1 = {
		{ KLO_DATA,	NULL,	 0, FALSE, FALSE },
		{ KLA_VALUE, DataBuf1, sizeof(DataBuf1), FALSE, FALSE }
	};
	KL_BYTE DataBuf2[16] = { 0x00, };
	KL_OBJECT oData2 = {
		{ KLO_DATA,	NULL,	 0, FALSE, FALSE },
		{ KLA_VALUE, DataBuf2, sizeof(DataBuf2), FALSE, FALSE }
	};

	//The Encryption Output of The First chunk
	KL_BYTE_PTR EncDataBuf1 = NULL;
	KL_OBJECT oEncryptedData1 = {
		{ KLO_DATA,	NULL, 0, FALSE, FALSE },
		{ KLA_VALUE, EncDataBuf1, 0, FALSE, FALSE }
	};
	//The Encryption Output of The Second chunk
	KL_BYTE_PTR EncDataBuf2 = NULL;
	KL_OBJECT oEncryptedData2 = {
		{ KLO_DATA,	NULL, 0, FALSE, FALSE },
		{ KLA_VALUE, EncDataBuf2, 0, FALSE, FALSE }
	};
	//The Encryption Output of The Final
	KL_BYTE_PTR EncDataBufF = NULL;
	KL_OBJECT oEncryptedDataF = {
		{ KLO_DATA,	NULL, 0, FALSE, FALSE },
		{ KLA_VALUE, EncDataBufF, 0, FALSE, FALSE }
	};

	//For Encryption Output
	KL_BYTE_PTR EncTotDataBuf = NULL;
	KL_OBJECT oEncryptedTotData = {
		{ KLO_DATA,	NULL, 0, FALSE, FALSE },
		{ KLA_VALUE, EncTotDataBuf, 0, FALSE, FALSE }
	};

	//For Decryption Output of The First chunk
	KL_BYTE_PTR DecDataBuf1 = NULL;
	KL_OBJECT oDecryptedData1 = {
		{ KLO_DATA,	NULL, 0, FALSE, FALSE },
		{ KLA_VALUE, DecDataBuf1, 0, FALSE, FALSE }
	};
	//For Decryption Output of The Second chunk
	KL_BYTE_PTR DecDataBuf2 = NULL;
	KL_OBJECT oDecryptedData2 = {
		{ KLO_DATA,	NULL, 0, FALSE, FALSE },
		{ KLA_VALUE, DecDataBuf2, 0, FALSE, FALSE }
	};
	//For Decryption Output of The Final
	KL_BYTE_PTR DecDataBufF = NULL;
	KL_OBJECT oDecryptedDataF = {
		{ KLO_DATA,	NULL, 0, FALSE, FALSE },
		{ KLA_VALUE, DecDataBufF, 0, FALSE, FALSE }
	};

	//For Decryption Output
	KL_BYTE_PTR DecTotDataBuf = NULL;
	KL_OBJECT oDecryptedTotData = {
		{ KLO_DATA,	NULL, 0, FALSE, FALSE },
		{ KLA_VALUE, DecTotDataBuf, 0, FALSE, FALSE }
	};

	KL_RV ret;

	//Step1 - ÆÄ¶ó¹ÌÅÍ ¼¼ÆÃ
	switch (op_mode) {

			/*ARIA*/
		case KLO_CTX_ARIA_CBC:
		case KLO_CTX_ARIA_CBC_PAD:
		case KLO_CTX_ARIA_OFB:
		case KLO_CTX_ARIA_CFB:
		case KLO_CTX_ARIA_CTR:
		case KLO_CTX_ARIA_CTR_PAD:
			encctx[1].type = KLA_BLOCK_IV;
			encctx[1].ulValueLen = KL_ARIA_BLOCK_BYTE_LEN;	//IV  Len : must be the same as the block size
		case KLO_CTX_ARIA_ECB:									//Note : ECB does note require IV
		case KLO_CTX_ARIA_ECB_PAD:
			oKey[1].ulValueLen = keylen;					//Key Len : This chooses one of versions(ARIA128, ARIA192, ARIA256)

			break;
	
	//Step 3(¾ÏÈ£È­) - ¾ÏÈ£È­
	////ÃÊ±âÈ­(Key-Scheule µ¿ÀÛ)
	if ((ret = K_EncryptInit(&encctx, (KL_OBJECT_PTR)&oKey)) != KLR_OK)
	{
		printf("K_EncryptInit failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}

	////Ã¹¹øÂ° Chunk - K_EncryptUpdate()
	////(Optional) ¾ÏÈ£È­ Ãâ·Â Å©±â¸¦ ¹ÝÈ¯(oEncryptedData[1].ulValueLen) : ÇØ´ç Sub-StepÀº »ç¿ëÀÚ°¡ Ãâ·Â BufferÀÇ Å©±â¸¦ ¾Ë°íÀÚ ÇÒ¶§ ¼öÇàÇÑ´Ù.
	oEncryptedData1[1].pValue = NULL;
	if ((ret = K_EncryptUpdate(&encctx, (KL_OBJECT_PTR)&oData1,
		(KL_OBJECT_PTR)&oEncryptedData1)) != KLR_OK)
	{
		printf("K_EncryptUpdate(Obtaining Output Length) failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	oEncryptedData1[1].pValue = (KL_BYTE_PTR)malloc(oEncryptedData1[1].ulValueLen);
	////¾ÏÈ£È­ ¼öÇà
	if ((ret = K_EncryptUpdate(&encctx, (KL_OBJECT_PTR)&oData1,
		(KL_OBJECT_PTR)&oEncryptedData1)) != KLR_OK)
	{
		printf("K_EncryptUpdate failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	////stdout
	K_HexDump(oEncryptedData1[1].pValue, oEncryptedData1[1].ulValueLen, "encrypted chunk1");

	oEncryptedTotData[1].pValue = (KL_BYTE_PTR)malloc(oEncryptedData1[1].ulValueLen);
	memcpy(oEncryptedTotData[1].pValue, oEncryptedData1[1].pValue, oEncryptedData1[1].ulValueLen);
	oEncryptedTotData[1].ulValueLen = oEncryptedData1[1].ulValueLen;
	
	////µÎ¹øÂ° Chunk - K_EncryptUpdate()
	////(Optional) ¾ÏÈ£È­ Ãâ·Â Å©±â¸¦ ¹ÝÈ¯(oEncryptedData[1].ulValueLen) : ÇØ´ç Sub-StepÀº »ç¿ëÀÚ°¡ Ãâ·Â BufferÀÇ Å©±â¸¦ ¾Ë°íÀÚ ÇÒ¶§ ¼öÇàÇÑ´Ù.
	oEncryptedData2[1].pValue = NULL;
	if ((ret = K_EncryptUpdate(&encctx, (KL_OBJECT_PTR)&oData2,
		(KL_OBJECT_PTR)&oEncryptedData2)) != KLR_OK)
	{
		printf("K_EncryptUpdate(Obtaining Output Length) failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	oEncryptedData2[1].pValue = (KL_BYTE_PTR)malloc(oEncryptedData2[1].ulValueLen);
	////¾ÏÈ£È­ ¼öÇà
	if ((ret = K_EncryptUpdate(&encctx, (KL_OBJECT_PTR)&oData1,
		(KL_OBJECT_PTR)&oEncryptedData2)) != KLR_OK)
	{
		printf("K_EncryptUpdate failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	////stdout
	K_HexDump(oEncryptedData2[1].pValue, oEncryptedData2[1].ulValueLen, "encrypted chunk2");

	oEncryptedTotData[1].pValue = (KL_BYTE_PTR)realloc(oEncryptedTotData[1].pValue, oEncryptedTotData[1].ulValueLen + oEncryptedData2[1].ulValueLen);
	memcpy(((KL_BYTE_PTR)oEncryptedTotData[1].pValue) + oEncryptedTotData[1].ulValueLen, oEncryptedData2[1].pValue, oEncryptedData2[1].ulValueLen);
	oEncryptedTotData[1].ulValueLen += oEncryptedData2[1].ulValueLen;

	////¸¶¹«¸® - K_EncryptUpdate()
	////(Optional) ¾ÏÈ£È­ Ãâ·Â Å©±â¸¦ ¹ÝÈ¯(oEncryptedData[1].ulValueLen) : ÇØ´ç Sub-StepÀº »ç¿ëÀÚ°¡ Ãâ·Â BufferÀÇ Å©±â¸¦ ¾Ë°íÀÚ ÇÒ¶§ ¼öÇàÇÑ´Ù.
	oEncryptedDataF[1].pValue = NULL;
	if ((ret = K_EncryptFinal(&encctx,
		(KL_OBJECT_PTR)&oEncryptedDataF)) != KLR_OK)
	{
		printf("K_EncryptFinal(Obtaining Output Length) failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	oEncryptedDataF[1].pValue = (KL_BYTE_PTR)malloc(oEncryptedDataF[1].ulValueLen);
	////¸¶¹«¸® ¼öÇà
	if ((ret = K_EncryptFinal(&encctx,
		(KL_OBJECT_PTR)&oEncryptedDataF)) != KLR_OK)
	{
		printf("K_EncryptFinal failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	////stdout
	K_HexDump(oEncryptedDataF[1].pValue, oEncryptedDataF[1].ulValueLen, "final");
	
	oEncryptedTotData[1].pValue = (KL_BYTE_PTR)realloc(oEncryptedTotData[1].pValue, oEncryptedTotData[1].ulValueLen + oEncryptedDataF[1].ulValueLen);
	memcpy(((KL_BYTE_PTR)oEncryptedTotData[1].pValue) + oEncryptedTotData[1].ulValueLen, oEncryptedDataF[1].pValue, oEncryptedDataF[1].ulValueLen);
	oEncryptedTotData[1].ulValueLen += oEncryptedDataF[1].ulValueLen;
	////stdout
	K_HexDump(oEncryptedTotData[1].pValue, oEncryptedTotData[1].ulValueLen, "encrypted data");

	//Step 3(º¹È£È­) - º¹È£È­ (À§ÀÇ ¾ÏÈ£È­°ªÀ» ÀÔ·ÂÀ¸·Î ÇÔ)
	////ÃÊ±âÈ­
	if ((ret = K_DecryptInit(&encctx,
		(KL_OBJECT_PTR)&oKey)) != KLR_OK)
	{
		printf("K_DecryptInit failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}

	////Ã¹¹øÂ° Chunk - K_EncryptUpdate()
	////(Optional) º¹È£È­ Ãâ·Â ±æÀÌ¸¦ ¹ÝÈ¯(oDecryptedData[1].ulValueLen) : ÇØ´ç Sub-StepÀº »ç¿ëÀÚ°¡ Ãâ·Â BufferÀÇ Å©±â¸¦ ¾Ë°íÀÚ ÇÒ¶§ ¼öÇàÇÑ´Ù.
	oDecryptedData1[1].pValue = NULL;
	if ((ret = K_DecryptUpdate(&encctx,
		(KL_OBJECT_PTR)&oEncryptedData1,
		(KL_OBJECT_PTR)&oDecryptedData1)) != KLR_OK)
	{
		printf("K_DecryptUpdate(Obtaining Output Length) failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	oDecryptedData1[1].pValue = (KL_BYTE_PTR)malloc(oDecryptedData1[1].ulValueLen);
	////º¹È£È­ ¼öÇà
	if ((ret = K_DecryptUpdate(&encctx,
		(KL_OBJECT_PTR)&oEncryptedData1,
		(KL_OBJECT_PTR)&oDecryptedData1)) != KLR_OK)
	{
		printf("K_DecryptUpdate failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	////stdout
	K_HexDump(oDecryptedData1[1].pValue, oDecryptedData1[1].ulValueLen, "decrypted chunck1");

	oDecryptedTotData[1].pValue = (KL_BYTE_PTR)malloc(oDecryptedData1[1].ulValueLen);
	memcpy(oDecryptedTotData[1].pValue, oDecryptedData1[1].pValue, oDecryptedData1[1].ulValueLen);
	oDecryptedTotData[1].ulValueLen = oDecryptedData1[1].ulValueLen;


	////µÎ¹øÂ° Chunk - K_EncryptUpdate()
	////(Optional) º¹È£È­ Ãâ·Â ±æÀÌ¸¦ ¹ÝÈ¯(oDecryptedData[1].ulValueLen) : ÇØ´ç Sub-StepÀº »ç¿ëÀÚ°¡ Ãâ·Â BufferÀÇ Å©±â¸¦ ¾Ë°íÀÚ ÇÒ¶§ ¼öÇàÇÑ´Ù.
	oDecryptedData2[1].pValue = NULL;
	if ((ret = K_DecryptUpdate(&encctx,
		(KL_OBJECT_PTR)&oEncryptedData2,
		(KL_OBJECT_PTR)&oDecryptedData2)) != KLR_OK)
	{
		printf("K_DecryptUpdate(Obtaining Output Length) failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	oDecryptedData2[1].pValue = (KL_BYTE_PTR)malloc(oDecryptedData2[1].ulValueLen);
	////º¹È£È­ ¼öÇà
	if ((ret = K_DecryptUpdate(&encctx,
		(KL_OBJECT_PTR)&oEncryptedData2,
		(KL_OBJECT_PTR)&oDecryptedData2)) != KLR_OK)
	{
		printf("K_DecryptUpdate failed: %s\n", K_GetErrorMsg(ret));
		goto err;
	}
	////stdout
	K_HexDump(oDecryptedData2[1].pValue, oDecryptedData2[1].ulValueLen, "decrypted chunck2");

	oDecryptedTotData[1].pValue = (KL_BYTE_PTR)realloc(oDecryptedTotData[1].pValue, oDecryptedTotData[1].ulValueLen + oDecryptedData2[1].ulValueLen);
	memcpy(((KL_BYTE_PTR)oDecryptedTotData[1].pValue) + oDecryptedTotData[1].ulValueLen, oDecryptedData2[1].pValue, oDecryptedData2[1].ulValueLen);
	oDecryptedTotData[1].ulValueLen += oDecryptedData2[1].ulValueLen;


	////¸¶¹«¸® - K_DecryptFinal()
	////(Optional) º¹È£È­ Ãâ·Â Å©±â¸¦ ¹ÝÈ¯(oEncryptedData[1].ulValueLen) : ÇØ´ç Sub-StepÀº »ç¿ëÀÚ°¡ Ãâ·Â BufferÀÇ Å©±â¸¦ ¾Ë°íÀÚ ÇÒ¶§ ¼öÇàÇÑ´Ù.
	oDecryptedDataF[1].pValue = NULL;
	if( (ret = K_DecryptFinal(&encctx,
		(KL_OBJECT_PTR)&oDecryptedDataF)) != KLR_OK )
	{
		printf("K_DecryptFinal(Obtaining Output Length) failed: %s\n",K_GetErrorMsg(ret));
		goto err;
	}
	oDecryptedDataF[1].pValue = (KL_BYTE_PTR)malloc(oDecryptedDataF[1].ulValueLen);
	////¸¶¹«¸® ¼öÇà
	if( (ret = K_DecryptFinal(&encctx,
		(KL_OBJECT_PTR)&oDecryptedDataF)) != KLR_OK )
	{
		printf("K_DecryptFinal failed: %s\n",K_GetErrorMsg(ret));
		goto err;
	}
	////stdout
	K_HexDump(oDecryptedDataF[1].pValue, oDecryptedDataF[1].ulValueLen, "final");

	oDecryptedTotData[1].pValue = (KL_BYTE_PTR)realloc(oDecryptedTotData[1].pValue, oDecryptedTotData[1].ulValueLen + oDecryptedDataF[1].ulValueLen);
	memcpy(((KL_BYTE_PTR)oDecryptedTotData[1].pValue) + oDecryptedTotData[1].ulValueLen, oDecryptedDataF[1].pValue, oDecryptedDataF[1].ulValueLen);
	oDecryptedTotData[1].ulValueLen += oDecryptedDataF[1].ulValueLen;

	////stdout
	K_HexDump(oDecryptedTotData[1].pValue, oDecryptedTotData[1].ulValueLen, "decrypted data");


err:
	K_ClearSensitive((KL_OBJECT_PTR)&encctx, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oKey, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oData1, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oData2, 2);

	K_ClearSensitive((KL_OBJECT_PTR)&oEncryptedData1, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oEncryptedData2, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oEncryptedDataF, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oEncryptedTotData, 2);

	K_ClearSensitive((KL_OBJECT_PTR)&oDecryptedData1, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oDecryptedData2, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oDecryptedDataF, 2);
	K_ClearSensitive((KL_OBJECT_PTR)&oDecryptedTotData, 2);

	if (oEncryptedData1[1].pValue != NULL)
		free(oEncryptedData1[1].pValue);
	if (oEncryptedData2[1].pValue != NULL)
		free(oEncryptedData2[1].pValue);
	if (oEncryptedDataF[1].pValue != NULL)
		free(oEncryptedDataF[1].pValue);
	if (oEncryptedTotData[1].pValue != NULL)
		free(oEncryptedTotData[1].pValue);


	if (oDecryptedData1[1].pValue != NULL)
		free(oDecryptedData1[1].pValue);
	if (oDecryptedData2[1].pValue != NULL)
		free(oDecryptedData2[1].pValue);
	if (oDecryptedDataF[1].pValue != NULL)
		free(oDecryptedDataF[1].pValue);
	if (oDecryptedTotData[1].pValue != NULL)
		free(oDecryptedTotData[1].pValue);
}

