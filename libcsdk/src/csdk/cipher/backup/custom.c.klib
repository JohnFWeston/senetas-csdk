int csdk_get_info( char ** info )
{
    KL_INFO klibinfo;
    K_CurrState(&klibinfo);
	
    int ret = asprintf(info, "KLIB v%u.%u, %s, lib v%u.%u, state (%ul)\n",
		    	klibinfo.klapiVersion.major, 
		    	klibinfo.klapiVersion.minor, 
		    	klibinfo.libraryDescription, 
		    	klibinfo.libraryVersion.major, 
		    	klibinfo.libraryVersion.minor,
			klibinfo.klib_mod_state);
    if (ret < 0)
	*info = NULL;
    return ret;
}

